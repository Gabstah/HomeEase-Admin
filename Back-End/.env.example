# Local dev (SQLite — works without installing PostgreSQL)
DATABASE_URL="file:./dev.db"

# Production / partner merge (PostgreSQL)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/homeease?schema=public"

# JWT secret — change in production
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Redis (required for AI verification queue)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Server
PORT=5000
NODE_ENV=development

# Comma-separated origins for CORS (admin + mobile dev servers)
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"
